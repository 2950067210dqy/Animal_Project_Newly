import time
import typing

import cv2
from PyQt6 import QtGui
from PyQt6.QtCore import QRect, Qt
from PyQt6.QtWidgets import QComboBox, QDialog, QDialogButtonBox, QLabel, QPushButton
from loguru import logger

from public.component.dialog.trajectory_deep_camera_config_dialog import Ui_deep_camera_config_dialog
from public.config_class.global_setting import global_setting
from public.entity.queue.ObjectQueueItem import ObjectQueueItem
from public.util.folder_util import folder_util
from public.util.json_util import json_util
from public.util.time_util import time_util


class trajectory_deep_camera_config_dialog(QDialog):
    def __init__(self, parent=None, geometry: QRect = None, title="", tip=""):
        super().__init__()
        self.tip = tip
        self.enabled_cage_ids = self._get_enabled_cage_ids() or list(range(1, 17))

        self.camera_series_list = []
        self.camera_series_list_select_need = []
        self.camera_series_choose_dict = {}
        self.mouse_cage_comboBox_dict = {}
        self.mouse_cage_checked_label_dict = {}
        self.mouse_cage_checked_label_btn_dict = {}

        self.refresh_btn: QPushButton | None = None
        self.ok_button: QPushButton | None = None

        self.get_data()
        self._init_ui(parent, geometry, title)
        self._init_customize_ui()
        self.init_data()

    def scan_realsense(self):
        cameras = []
        for index in range(10):
            cap = cv2.VideoCapture(index, cv2.CAP_DSHOW) if hasattr(cv2, "CAP_DSHOW") else cv2.VideoCapture(index)
            if cap is None or not cap.isOpened():
                if cap is not None:
                    cap.release()
                continue

            ret, _ = cap.read()
            width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH) or 0)
            height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT) or 0)
            cap.release()
            if not ret:
                continue

            cameras.append(
                {
                    "id": len(cameras) + 1,
                    "serial": f"uvc_index_{index}",
                    "instance_id": f"uvc_index_{index}",
                    "display_name": f"UVC Camera {index} ({width}x{height})" if width and height else f"UVC Camera {index}",
                    "device_index": index,
                }
            )
        return cameras

    def showEvent(self, a0: typing.Optional[QtGui.QShowEvent]) -> None:
        logger.info("deep camera config dialog show")
        super().showEvent(a0)

    def hideEvent(self, a0: typing.Optional[QtGui.QHideEvent]) -> None:
        logger.info("deep camera config dialog hide")
        super().hideEvent(a0)

    def _get_enabled_cage_ids(self):
        try:
            experiment_setting = global_setting.get_setting("experiment_setting", None)
            if experiment_setting is None or not getattr(experiment_setting, "groups", None):
                return []
            return sorted([g.id for g in experiment_setting.groups if getattr(g, "is_selected", 0) == 1])
        except Exception as e:
            logger.error(f"获取已启用笼子失败: {e}")
            return []

    def _init_ui(self, parent=None, geometry: QRect = None, title=""):
        if parent is not None and geometry is not None:
            self.setParent(parent)
            self.setGeometry(geometry)

        self.ui = Ui_deep_camera_config_dialog()
        self.ui.setupUi(self, enabled_cage_ids=self.enabled_cage_ids)
        self.setParent(None)
        self.setWindowFlag(Qt.WindowType.WindowCloseButtonHint, False)
        self.setModal(True)
        self.setWindowTitle(title)

    def _init_customize_ui(self):
        tip_label: QLabel = self.findChild(QLabel, "tip_label")
        if tip_label is not None:
            tip_label.setText(f"{tip_label.text()}{self.tip}")

        self.init_label()
        self.init_label_btn()
        self.init_combox()
        self.init_btn_other()
        self.combox_connect_func()
        self.label_btn_connect_func()
        self.btn_other_connect_func()

    def show_frame(self):
        self.exec()

    def get_data(self):
        self.camera_series_list = self.scan_realsense()
        self.camera_series_list_select_need = list(self.camera_series_list)

    def init_data(self):
        try:
            config_file_path = f"./{global_setting.get_setting('camera_config')['DEEP_CAMERA']['camera_to_mouse_cage_number_file_name']}"
            if not folder_util.is_exist_file(config_file_path):
                return

            serials = json_util.read_json_to_dict_list(config_file_path)
            for data in serials:
                cage_id = data.get("mouse_cage_number")
                if cage_id not in self.enabled_cage_ids:
                    continue
                self.camera_series_choose_dict[cage_id] = data
                label = self.mouse_cage_checked_label_dict.get(cage_id)
                if label is not None:
                    label.setText(data.get("display_name") or data.get("serial", "未选中"))

            selected_serials = {item.get("serial") for item in self.camera_series_choose_dict.values()}
            self.camera_series_list_select_need = [
                item for item in self.camera_series_list_select_need if item.get("serial") not in selected_serials
            ]
            self.init_combox()
            self.combox_connect_func()
        except Exception as e:
            logger.error(f"加载深度相机配置失败: {e}")

    def init_label(self):
        for cage_id in self.enabled_cage_ids:
            label = self.findChild(QLabel, f"d_mouse_cage_{cage_id}_checked_value")
            if label is not None:
                self.mouse_cage_checked_label_dict[cage_id] = label

    def init_label_btn(self):
        for cage_id in self.enabled_cage_ids:
            btn = self.findChild(QPushButton, f"d_mouse_cage_{cage_id}_checked_value_btn")
            if btn is not None:
                self.mouse_cage_checked_label_btn_dict[cage_id] = btn

    def label_btn_connect_func(self):
        for cage_id, btn in self.mouse_cage_checked_label_btn_dict.items():
            btn.clicked.connect(lambda checked=False, cage_num=cage_id: self.label_btn_func(cage_num))

    def label_btn_func(self, cage_num):
        old_value = self.camera_series_choose_dict.pop(cage_num, None)
        if old_value is not None:
            self.camera_series_list_select_need.append(
                {
                    "id": len(self.camera_series_list_select_need) + 1,
                    "serial": old_value.get("serial"),
                    "instance_id": old_value.get("instance_id", old_value.get("serial")),
                    "display_name": old_value.get("display_name", old_value.get("serial")),
                    "device_index": old_value.get("device_index"),
                }
            )

        label = self.mouse_cage_checked_label_dict.get(cage_num)
        if label is not None:
            label.setText("未选中")
        self.init_combox()
        self.combox_connect_func()

    def init_combox(self):
        for cage_id in self.enabled_cage_ids:
            combo = self.findChild(QComboBox, f"d_mouse_cage_{cage_id}_select")
            if combo is None:
                continue
            combo.clear()
            for camera_obj in self.camera_series_list_select_need:
                combo.addItem(f"-相机: {camera_obj.get('display_name', camera_obj.get('serial', ''))}")
            self.mouse_cage_comboBox_dict[cage_id] = combo

    def toggle_signal_combox(self, flag=True):
        for combo in self.mouse_cage_comboBox_dict.values():
            combo.blockSignals(flag)

    def combox_disconnect_func(self):
        for combo in self.mouse_cage_comboBox_dict.values():
            try:
                combo.disconnect()
            except Exception:
                pass

    def combox_connect_func(self):
        self.combox_disconnect_func()
        for cage_id, combo in self.mouse_cage_comboBox_dict.items():
            combo.activated.connect(lambda data_index, cage_num=cage_id: self.selection_change_combox(cage_num, data_index))

    def selection_change_combox(self, cage_num, data_index):
        if data_index < 0 or data_index >= len(self.camera_series_list_select_need):
            return

        selected_camera = self.camera_series_list_select_need[data_index]
        old_value = self.camera_series_choose_dict.get(cage_num)
        if old_value is not None:
            self.camera_series_list_select_need.append(
                {
                    "id": len(self.camera_series_list_select_need) + 1,
                    "serial": old_value.get("serial"),
                    "instance_id": old_value.get("instance_id", old_value.get("serial")),
                    "display_name": old_value.get("display_name", old_value.get("serial")),
                    "device_index": old_value.get("device_index"),
                }
            )

        self.camera_series_choose_dict[cage_num] = {
            "mouse_cage_number": cage_num,
            "serial": selected_camera.get("serial"),
            "instance_id": selected_camera.get("instance_id", selected_camera.get("serial")),
            "display_name": selected_camera.get("display_name", selected_camera.get("serial")),
            "device_index": selected_camera.get("device_index"),
        }

        self.camera_series_list_select_need = [
            item for idx, item in enumerate(self.camera_series_list_select_need) if idx != data_index
        ]

        label = self.mouse_cage_checked_label_dict.get(cage_num)
        if label is not None:
            label.setText(self.camera_series_choose_dict[cage_num]["display_name"])

        self.init_combox()
        self.combox_connect_func()

    def init_btn_other(self):
        button_box = self.findChild(QDialogButtonBox, "dialog_btn")
        if button_box is not None:
            self.ok_button = button_box.button(QDialogButtonBox.StandardButton.Ok)
        self.refresh_btn = self.findChild(QPushButton, "refresh")

    def btn_other_connect_func(self):
        if self.ok_button is not None:
            self.ok_button.clicked.connect(self.ok_func)
        if self.refresh_btn is not None:
            self.refresh_btn.clicked.connect(self.refresh_func)

    def refresh_func(self):
        self.get_data()
        selected_serials = {item.get("serial") for item in self.camera_series_choose_dict.values()}
        self.camera_series_list_select_need = [
            item for item in self.camera_series_list_select_need if item.get("serial") not in selected_serials
        ]
        self.init_combox()
        self.combox_connect_func()

    def ok_func(self):
        try:
            choose_data = [self.camera_series_choose_dict[cage_id] for cage_id in sorted(self.camera_series_choose_dict.keys())]
            config_file_path = f"./{global_setting.get_setting('camera_config')['DEEP_CAMERA']['camera_to_mouse_cage_number_file_name']}"
            json_util.store_json_from_dict_list(filename=config_file_path, data=choose_data)

            queue = global_setting.get_setting("queue", None)
            if queue is not None:
                queue.put(
                    ObjectQueueItem(
                        origin="deep_camera_config_dialog_index",
                        to="main_deep_camera",
                        data=choose_data,
                        title="camera_config",
                        time=time_util.get_format_from_time(time.time()),
                    )
                )
            self.accept()
        except Exception as e:
            logger.error(f"保存深度相机配置失败: {e}")
